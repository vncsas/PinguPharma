NODE_ENV=development
PORT=3333
HOST=0.0.0.0

DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-supersecret-min-32-chars-long-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Expõe devToken na resposta do reset (só vale com NODE_ENV=development)
EXPOSE_DEV_RESET_TOKEN=false

CORS_ORIGIN="http://localhost:5173"

TWOFA_ISSUER="PinguPharma"

# Seed inicial (rodar apenas em dev)
SEED_ADMIN_PASSWORD="troque-antes-de-usar"

# E-mail: console (loga no terminal) ou smtp
# MAIL_DRIVER="console"
# MAIL_FROM="PinguPharma <no-reply@pingupharma.dev>"
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""

# Agendador diário de alertas (validade/estoque)
# ALERTS_SCHEDULE_ENABLED=true
# ALERTS_RUN_HOUR=7
